# Copy this file to .env when local overrides are useful.
# The current SDK does not require credentials or any secret values.

# Optional location of the agent Skill workspace used by the standalone CLI.
EGO_BROWSER_AGENT_WORKSPACE=./skills/ego-browser

# Optional path to an installed Ego Lite CLI for real-browser E2E tests.
EGO_BROWSER_REAL_E2E_CLI=

# Reserved network-wrapper defaults; the current MCP transport is stdio and does
# not bind a host or port. Active DAST remains disabled unless it is explicitly
# enabled and the request satisfies the service policy.
MCP_HOST=127.0.0.1
MCP_PORT=3000
EGO_SECURITY_DB_PATH=./data/ego-security.sqlite
# JSON array of explicitly authorized targets. Keep this local configuration
# private when it contains internal hostnames.
EGO_SECURITY_TARGETS_JSON=[]
EGO_MCP_ENABLE_DAST=false
EGO_MCP_DAST_TARGETS=
EGO_MCP_DAST_ENVIRONMENTS=test,staging
EGO_MCP_DAST_MAX_REQUESTS=50
