{
  "name": "@ego-lite/browser-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Portable Playwright Chromium adapter with redacted browser telemetry",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/browser-adapter.test.js"
  },
  "dependencies": {
    "@ego-lite/security-core": "file:../security-core",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "typescript": "5.8.3"
  },
  "license": "MIT"
}
