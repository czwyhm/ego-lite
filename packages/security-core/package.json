{
  "name": "@ego-lite/security-core",
  "version": "0.1.0",
  "description": "Small, defensive security telemetry and analysis core for Ego Lite",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/security-core.test.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "typescript": "5.8.3"
  },
  "license": "MIT"
}
