{
  "name": "@ego-lite/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP telemetry and security analysis service for Ego Lite",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "start": "node dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@ego-lite/browser-adapter": "file:../browser-adapter",
    "@ego-lite/security-core": "file:../security-core"
  }
}
